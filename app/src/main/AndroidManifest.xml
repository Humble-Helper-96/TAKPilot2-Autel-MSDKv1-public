<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.autel.sdksample">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lets the ExplorerWatchdog call ActivityManager.killBackgroundProcesses on Autel Explorer
         when it tries to seize the aircraft link. Normal permission, granted at install. Makes no
         permanent change — Explorer respawns on its next wake. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only REQUIRED at targetSdk 34+; declared now so a future targetSdk bump does not
         silently break screen capture. Harmless on this build (targetSdk 29 / Android 11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Support devices without USB host mode since there are other connection types -->
    <application
        android:name=".TestApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">
        <uses-library android:name="com.android.future.usb.accessory" />

        <activity
            android:name=".ProductActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".evo.G2RemoteControllerActivity" />
        <activity android:name=".evo.G2FlyControllerActivity" />
        <activity android:name=".evo.G2GimbalActivity" />
        <activity android:name=".evo.G2DspActivity" />
        <activity android:name=".evo.G2BatteryActivity" />
        <activity android:name=".xstar.XStarRemoteControllerActivity" />
        <activity android:name=".xstar.XStarFlyControllerActivity" />
        <activity android:name=".xstar.XStarGimbalActivity" />
        <activity android:name=".xstar.XStarDspActivity" />
        <activity android:name=".xstar.XStarBatteryActivity" />
        <activity android:name=".premium.XStarPremiumRemoteControllerActivity" />
        <activity android:name=".premium.XStarPremiumFlyControllerActivity" />
        <activity android:name=".premium.XStarPremiumGimbalActivity" />
        <activity android:name=".premium.XStarPremiumDspActivity" />
        <activity android:name=".premium.XStarPremiumBatteryActivity" />
        <activity android:name=".TestActivity" />
        <activity
            android:name=".base.camera.CameraActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape" />
        <activity android:name=".base.BatteryActivity" />
        <activity android:name=".base.album.AlbumActivity" />
        <activity
            android:name=".base.mission.MissionActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.mission.AMapMissionActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.mission.GMapMissionActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.CodecActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".base.CodecViewActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/CodecTheme" />

        <receiver android:name=".UsbBroadCastReceiver">
            <intent-filter>
                <action android:name="com.autel.sdk.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </receiver>

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />
        <meta-data
            android:name="com.google.android.maps.v2.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".evo.visual.VisualActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".evo.avoid.AvoidActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.autel.internal.XStarPremiumUpgradeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="landscape" />
        <activity
            android:name=".evo.visual.DynamicTrackActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:screenOrientation="landscape" />
        <activity android:name=".ZteLogActivity"></activity>

        <!-- ============ TAKPilot2-Autel components ============ -->
        <!-- Home is the hub and the launcher. singleTask keeps exactly ONE Home in the task,
             so a stacked second Home is impossible rather than merely avoided by remembering
             the right intent flags at each call site. -->
        <activity
            android:name=".tak.TakPilotHomeActivity"
            android:theme="@style/AppTheme.NoActionBar.SolidStatusBar"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".tak.FlightActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".tak.TakConnectActivity"
            android:label="Pre-Flight Setup"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".tak.DataSyncActivity"
            android:label="Data Sync"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <!-- Hosts the MediaProjection for the outbound screen-capture stream. Android 10+
             requires a foreground service of this type to be running BEFORE the projection
             is used, so this cannot be folded into TakForegroundService (which is dataSync). -->
        <service android:name=".tak.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <service android:name=".tak.TakForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- TAK SERVER — the connection configuration, kept off Pre-Flight by design.
             Same shape as the video-servers screen: a set-once configuration that
             buried the things a pilot actually reads before a flight. -->
        <activity android:name=".tak.TakServerActivity"
            android:label="TAK Server"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".tak.VideoServersActivity"
            android:label="Video Servers"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".tak.DebugActivity"
            android:label="Debug Log"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".tak.FieldGuideActivity"
            android:label="Field Guide"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>