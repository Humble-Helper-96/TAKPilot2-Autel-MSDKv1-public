<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon BACKGROUND layer: flat navy, edge to edge.

     Deliberately a plain field. The launcher masks this layer to whatever shape the device
     uses (circle, squircle, rounded square) and shifts it under the foreground for parallax,
     so anything drawn here would be cropped differently on every launcher and slide around
     independently of the aircraft. The mark belongs in the foreground; this is the flag. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_navy"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
