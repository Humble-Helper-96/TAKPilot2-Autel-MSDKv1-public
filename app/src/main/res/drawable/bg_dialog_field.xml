<?xml version="1.0" encoding="utf-8"?>
<!-- Text-input background for fields INSIDE a dialog.

     The section fields get away with a flat tp_surface_field fill because the page behind them
     is near-black. A dialog surface (#202020) is only a shade darker than the field fill
     (#2A2A2A), so the same treatment there produces a field a user cannot identify as
     one. The stroke is what says "type here"; the corner radius matches the
     dialog's own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tp_surface_field" />
    <stroke android:width="1dp" android:color="@color/tp_text_muted" />
    <corners android:radius="6dp" />
</shape>
