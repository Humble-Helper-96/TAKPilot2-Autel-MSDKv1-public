<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window background for TakDialogTheme — same dark-card language as
     home_flight_card.xml (solid instead of gradient, since these are content-dense dialogs
     not a single hero button). Replaces the AlertDialog's default light 9-patch panel, so
     these dialogs also lose its built-in drop shadow/inset — acceptable, matches the flat
     card look used elsewhere in this app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A1B1E" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#2A4A7A" />
</shape>
