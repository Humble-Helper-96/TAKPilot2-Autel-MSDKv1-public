<?xml version="1.0" encoding="utf-8"?>
<!-- Inbound AIR track whose sender reported NO course.

     A ring containing a FRONT-TO-BACK SYMMETRIC cross. Deliberately not the winged silhouette
     of ic_air_track: that one has a nose, and drawn unrotated it would show every course-less
     aircraft flying due north — a confident-looking wrong answer, which is worse on an
     air-traffic symbol than an obviously non-committal one.

     The cross has no front, so there is no heading to misread, and the ring keeps it clearly
     distinct from the plain team dots used for TAK clients. Rare in practice — airborne ADS-B
     targets almost always report a track; this is mostly surface targets and odd feeds. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#B316232B"
        android:pathData="M12,2.6 A9.4,9.4 0 1,1 11.99,2.6 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.9,6.4 L13.1,6.4 L13.1,10.9 L17.6,10.9 L17.6,13.1 L13.1,13.1 L13.1,17.6 L10.9,17.6 L10.9,13.1 L6.4,13.1 L6.4,10.9 L10.9,10.9 Z" />
</vector>
