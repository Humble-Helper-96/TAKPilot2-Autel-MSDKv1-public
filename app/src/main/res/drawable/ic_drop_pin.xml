<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar "drop a marker at the camera crosshair" button.

     A map pin sitting IN a reticle, with the pin's tip landing on the reticle's centre — the
     composition is the explanation of what the button does: the marker goes wherever the
     camera is aimed, not wherever you tap. The reticle deliberately mimics CrosshairView's
     on-screen shape (gapped arms + centre ring) so the button reads as "that crosshair, the
     one on the video". Cyan matches the aircraft marker / resync accent already in the
     toolbar; the pin is white like the other action glyphs. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Reticle first, so the pin overlaps it rather than the other way round. -->
    <path
        android:pathData="M12,11.9a3.6,3.6 0 1,0 0,7.2a3.6,3.6 0 1,0 0,-7.2"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M0.8,15.5L7.0,15.5M17.0,15.5L23.2,15.5M12,20.2L12,23.4"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

    <!-- Pin: teardrop with an evenOdd hole punched through, tip resting on the reticle centre. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1.6c-2.76,0 -5,2.24 -5,5c0,3.6 5,9.2 5,9.2s5,-5.6 5,-9.2c0,-2.76 -2.24,-5 -5,-5zM12,4.4a2.2,2.2 0 1,0 0,4.4a2.2,2.2 0 1,0 0,-4.4z" />
</vector>
