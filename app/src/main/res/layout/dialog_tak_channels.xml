<?xml version="1.0" encoding="utf-8"?>
<!-- TAK channels, from the flight screen (FlightActivity.onTakChannelsTapped).

     Reached by a touch-and-hold on the TAK badge, so a pilot can change the scope of this
     aircraft WITHOUT leaving the flight screen. Leaving it stops the video to the team, which is
     the last thing a pilot wants in the middle of a sortie.

     Scrolls because it opens over live video in landscape, the same reason dialog_ar_options.xml
     does.

     Inflated with a ContextThemeWrapper on TakDialogTheme. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- ⚠ NO "the TAK server holds these channels" LINE HERE (design decision).
             Where the state lives is something a pilot opening this dialog in flight does not
             need told every time — and on this screen it would cost a line the two channel lists
             need. The fact is on the TAK Server screen's own channel section and in the
             Field Guide, which are where somebody reads it once. -->

        <!-- Shown only when the TAK configuration is locked. -->
        <TextView
            android:id="@+id/takChanLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textColor="@color/tp_state_caution"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="Locked. Touch Unlock to change a channel." />

        <!-- Filled in code, one row for each channel. -->
        <LinearLayout
            android:id="@+id/takChanList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/takChanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp"
            android:text="" />

        <!-- The ELEVATED account's channels: shown under the Standard account's so the pilot
             sees the whole scope of this aircraft in flight. WRITABLE, behind the same lock as
             the Standard rows — a tick is also the only possible "ignore incoming" control,
             because inbound CoT carries no channel label. ⚠ If the Elevated account is shared
             by several controllers, a change here reaches every one of them. Both GONE until an
             Elevated enrollment exists. -->
        <TextView
            android:id="@+id/takChanElevatedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="Elevated account (video)" />

        <LinearLayout
            android:id="@+id/takChanElevatedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
