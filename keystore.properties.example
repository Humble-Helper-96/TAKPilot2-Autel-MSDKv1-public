# Release signing — copy this file to keystore.properties (repository root) and fill it in.
#
# keystore.properties and your keystore file are GITIGNORED and must stay that way.
# Without keystore.properties, `assembleRelease` produces an unsigned APK and debug builds use
# the Android debug key.

storeFile=your-release-key.jks
storePassword=
keyAlias=
keyPassword=
